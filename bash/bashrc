# Login shell stays bash so system scripts keep working; interactive shells hand off to zsh.

[[ $- != *i* ]] && return

export PATH="$HOME/.local/bin:$PATH"

# Running `bash` from zsh or `bash -c` stays in bash
if command -v zsh > /dev/null 2>&1 \
  && [[ $(ps --no-header --pid=$PPID --format=comm) != "zsh" && -z ${BASH_EXECUTION_STRING} ]]; then
  shopt -q login_shell && exec zsh --login
  exec zsh
fi
